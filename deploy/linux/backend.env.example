# Copy to /etc/pojian/backend.env on the deployment host and chmod 600.
# Fill provider values with the user's chosen API. No real secrets belong here.
EMERGE_HOST=127.0.0.1
EMERGE_PORT=28763
EMERGE_BUDGET_DB=/var/lib/pojian-backend/monitor-budget.sqlite3
# User will configure the API later. Until then authenticated analysis returns 503.
EMERGE_ALLOW_UNCONFIGURED=1
EMERGE_UPSTREAM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Replace with the actual model name available in your workspace before use.
EMERGE_UPSTREAM_MODEL=qwen-plus
EMERGE_UPSTREAM_API_KEY=
EMERGE_SERVICE_TOKEN=
EMERGE_UPSTREAM_TIMEOUT=40
EMERGE_CONCURRENCY=4
EMERGE_MONITOR_DAILY_LIMIT=200
# Admin console account; password defaults to EMERGE_SERVICE_TOKEN when left empty.
EMERGE_ADMIN_USER=admin
EMERGE_ADMIN_PASSWORD=
# Optional; vision URL/key fall back to the text provider when omitted.
EMERGE_VISION_MODEL=
TAVILY_API_KEY=
