# Copy to /etc/pojian/backend.env on the deployment host and chmod 600.
# Fill provider values with the user's chosen API. No real secrets belong here.
EMERGE_HOST=127.0.0.1
EMERGE_PORT=28763
EMERGE_BUDGET_DB=/var/lib/pojian-backend/monitor-budget.sqlite3
# User will configure the API later. Until then authenticated analysis returns 503.
EMERGE_ALLOW_UNCONFIGURED=1
EMERGE_UPSTREAM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Replace with the actual model name available in your workspace before use.
EMERGE_UPSTREAM_MODEL=qwen-plus
EMERGE_UPSTREAM_API_KEY=
EMERGE_SERVICE_TOKEN=
# Legacy /analyze only; /monitor shares a fixed 110-second request budget.
EMERGE_UPSTREAM_TIMEOUT=40
EMERGE_CONCURRENCY=4
EMERGE_MONITOR_DAILY_LIMIT=200
# Independent admin password; missing or equal to the service token disables admin login.
# Keep EMERGE_SERVICE_TOKEN unchanged so existing APKs continue to work.
EMERGE_ADMIN_USER=admin
EMERGE_ADMIN_PASSWORD=
# Optional; vision URL/key fall back to the text provider when omitted.
EMERGE_VISION_MODEL=
TAVILY_API_KEY=
# In-app update proxy: serves /app-update manifest + APK from the private repo's latest
# GitHub Release. Fine-grained token with Contents read access on that repo only.
# Leave empty to keep both endpoints disabled (404).
EMERGE_APP_UPDATE_TOKEN=
EMERGE_APP_UPDATE_REPO=baijiamin/PoJian
# Public base used for the apkUrl in the manifest; must match the nginx mount prefix.
# Empty derives it from the request Host (no prefix), which only fits a root mount.
EMERGE_APP_UPDATE_BASE=
# Set to the public R2 bucket HTTPS URL to migrate existing app installations.
# The gateway returns the R2 APK URL; no R2 access keys belong on the server.
EMERGE_APP_UPDATE_R2_BASE=
# Public APK repository; takes precedence over R2 and private GitHub proxy.
EMERGE_APP_UPDATE_PUBLIC_REPO=baijiamin/PoJian-Releases

# Optional signed V2 semantic API. Legacy /monitor and /analyze stay available.
# JSON object output is always validated against the strict local schema.
# Select json_schema only for providers/models that support strict schema mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
LLM_RESPONSE_FORMAT=json_object
# Base64 raw 32-byte Ed25519 private seed, generated once and stored only here.
# Android pins its public key and the approved release measurement out of band.
# No built-in shared/HMAC secret. Empty keeps V2 endpoints unavailable (503).
POJIAN_SIGNING_PRIVATE_KEY=
POJIAN_STATE_DB=/var/lib/pojian-backend/security.sqlite3
# Explicitly enable only in the authenticated admin console for a rehearsal.
POJIAN_ENABLE_DEBUG=0
