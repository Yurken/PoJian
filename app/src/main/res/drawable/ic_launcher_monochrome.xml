<?xml version="1.0" encoding="utf-8"?>
<!-- Reuse the same alpha silhouette so themed and full-color icons stay aligned. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="22%"
    android:insetTop="22%"
    android:insetRight="22%"
    android:insetBottom="22%">
    <bitmap android:src="@mipmap/ic_launcher_artwork"
        android:gravity="fill" android:filter="true"
        android:tint="@android:color/white" android:tintMode="src_in" />
</inset>
